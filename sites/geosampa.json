        {
          "name": "numero",
          "type": "string",
          "required": true,
          "description": "Número de porta do imóvel (ex: 1000).",
          "example": "1000"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "logradouro": "PAULISTA",
            "numero": "1000"
          },
          "expect": "result",
          "purpose": "Busca por endereço Av. Paulista 1000 retorna o lote correspondente."
        },
        {
          "args": {
            "logradouro": "INEXISTENTE",
            "numero": "99999"
          },
          "expect": "empty",
          "purpose": "Logradouro fictício retorna lista vazia."
        }
      ]
    },
