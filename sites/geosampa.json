{
  "name": "geosampa",
  "displayName": "GeoSampa (São Paulo)",
  "baseUrl": "https://geosampa.prefeitura.sp.gov.br",
  "description": "Consulta dados cadastrais, fiscais e urbanísticos oficiais da cidade de São Paulo (IPTU/SQL, lotes, zoneamento LPUOS, patrimônio tombado e áreas contaminadas) via GeoSampa WFS.",
  "operations": [
    {
      "name": "getLoteBySql",
      "description": "Busca um lote fiscal paulistano pelo número do SQL (Setor, Quadra e Lote do IPTU).",
      "request": {
        "method": "GET",
        "url": "https://wfs.geosampa.prefeitura.sp.gov.br/geoserver/geoportal/wfs?service=WFS&version=1.0.0&request=GetFeature&typeName=geoportal:lote_cidadao&outputFormat=application/json&CQL_FILTER=cd_setor_fiscal%3D%27{setor}%27%20and%20cd_quadra_fiscal%3D%27{quadra}%27%20and%20cd_lote%3D%27{lote}%27",
        "headers": {
          "accept": "application/json, text/plain, */*",
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "setor",
          "at": [
            "query:CQL_FILTER"
          ],
          "template": "cd_setor_fiscal='{setor}' and cd_quadra_fiscal='{quadra}' and cd_lote='{lote}'"
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://wfs.geosampa.prefeitura.sp.gov.br/geoserver/geoportal/wfs?service=WFS&version=1.0.0&request=GetFeature&typeName=geoportal:lote_cidadao&outputFormat=application/json&CQL_FILTER=cd_setor_fiscal%3D%27{setor}%27%20and%20cd_quadra_fiscal%3D%27{quadra}%27%20and%20cd_lote%3D%27{lote}%27"
      },
      "match": {
        "method": "GET",
        "host": "wfs.geosampa.prefeitura.sp.gov.br",
        "path": "/geoserver/geoportal/wfs"
      },
      "response": {
        "format": "json",
        "extract": "features",
        "pick": [
          "id",
          "setor=properties.cd_setor_fiscal",
          "quadra=properties.cd_quadra_fiscal",
          "lote=properties.cd_lote",
          "digito=properties.cd_digito_sql",
          "logradouro=properties.nm_logradouro_completo",
          "numero=properties.cd_numero_porta",
          "complemento=properties.tx_complemento_endereco",
          "uso=properties.dc_tipo_uso_imovel",
          "areaTerreno=properties.qt_area_terreno",
          "areaConstruida=properties.qt_area_construida",
          "situacao=properties.tx_situ_lote",
          "coordinates=geometry.coordinates",
          "geometryType=geometry.type"
        ]
      },
      "params": [
        {
          "name": "setor",
          "type": "string",
          "required": true,
          "description": "Código do setor fiscal com 3 dígitos (ex: 009).",
          "example": "009"
        },
        {
          "name": "quadra",
          "type": "string",
          "required": true,
          "description": "Código da quadra fiscal com 3 dígitos (ex: 048).",
          "example": "048"
        },
        {
          "name": "lote",
          "type": "string",
          "required": true,
          "description": "Código do lote fiscal com 4 dígitos (ex: 0138).",
          "example": "0138"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "setor": "009",
            "quadra": "048",
            "lote": "0138"
          },
          "expect": "result",
          "purpose": "Lote público conhecido na Av. Paulista 1000 retorna dados fiscais e geometria."
        },
        {
          "args": {
            "setor": "000",
            "quadra": "000",
            "lote": "0000"
          },
          "expect": "empty",
          "purpose": "SQL inexistente retorna lista vazia."
        }
      ]
    },
    {
